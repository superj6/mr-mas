 "inner_voice": {
  "lines": 17,
  "rows": [
   "act1 5.04 v34-vo-01: she's right. it will break. it goes out tonight anyway.",
   "act1 5.11 v3-vo-05: i know. i still read it twice.",
   "act1 7.01 v34-vo-02: mostly the bill. we can't buy that many servers. someone can.",
   "act1 v35-12.02 v35-vo-01: they've stopped testing it. they're using it.",
   "act1 9.09 v3-vo-09: it does.",
   "act1 v35-19.03 v35-vo-02: someone gets to be in the room.",
   "act1 11.03 v3-vo-10: mario used to sit where gerg sits. he left to build a careful one.",
   "act2 13.13 v34-vo-04: mine's half written.",
   "act3 18.02 v34-vo-05: my other company. for when it gets harder to tell.",
   "act3 22.01 v34-vo-06: a year ago, forty users and a nice thread.",
   "act3 22.02 v3-vo-16: thrilled is too much. enthusiastic is a lot.",
   "act4 S1.02 v34-vo-07: gerg's not on it. probably the budget. good. i'll ask for more compute.",
   "act4 v35-41.01 v35-vo-03: the budget. i said the budget.",
   "act4 v35-41.04 v35-vo-04: gerg. tasya. the money. the money. the money.",
   "act4 S2.01 a5-26a-01: i don't keep score.",
   "act4 S8.04 v34-vo-11: they had four votes. i had the landlord. the money. gerg.",
   "tag 32.03 v3-vo-24: it looks calmer than me."
  ]
 },
