# ---------------------------------------------------------------------------
# MR. MAS — what stays out of git
# Rule of thumb: code, docs, stills and audio masters are committed;
# videos, dependencies, third-party sample libraries and caches are not.
# Everything ignored here can be re-created. See README.md → "Re-rendering".
# ---------------------------------------------------------------------------

# Videos (rendered outputs; re-render with the commands in docs/RENDERING.md)
*.mp4
*.mov
*.webm
*.mkv
*.m4v
*.avi

# Node / Remotion
node_modules/
studio/.remotion/
studio/out/
*.tsbuildinfo

# Python environments and bytecode (re-create from audio/requirements/*.txt)
.venv*/
__pycache__/
*.pyc

# Third-party sample libraries (downloaded; sources and licenses listed in audio/samples/LICENSES.md)
audio/samples/*
!audio/samples/LICENSES.md
!audio/samples/fetch_samples.sh
!audio/samples/MANIFEST.sha256

# Caches, scratch and temp work
audio/**/_work/
audio/**/cache/
audio/**/tts_cache/
**/tmp/
**/.tmp/
*.log
# the Act Four dialogue recording logs are records that cannot be regenerated (docs/ORGANIZATION-PLAN.md §9 item 3)
!audio/ep01/act4/dialogue/qa/*.log

# Regenerable temp audio beds for the story reels (~50 MB each; rebuild with audio/reel/build_all.py)
audio/reel/*.wav

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# genvideo (studio/tools/genvideo): demo clips converted by the test bench (rebuild: test_genvideo.py).
# Real converted inserts (studio/public/genvideo/<shot>/: indexed PNG drawings + clip.json) ARE committed:
# a model's output can't be regenerated bit for bit.
studio/public/genvideo/_test/
.backups/

# API keys and secrets (never commit)
.env
*.env
.secrets/

# Rendered audio (regenerable; see docs/RENDERING.md and each track's README)
# OST renders: masters, stems, loops and per-render MP3 previews. Cue sheets, READMEs and MIDI stay tracked.
audio/ost/tracks/*/render/**/*.wav
audio/ost/tracks/*/render/**/*.flac
audio/ost/tracks/*/render/**/*.mp3
# Dialogue takes (TTS WAVs; MP3 previews stay tracked) and mixes/premixes under out/
audio/ep01/**/*.wav
out/**/*.wav
# Derived web copies for the review page (sources live elsewhere in out/)
out/review-desk/*.mp4
out/review-desk/*.mp3
# Reel beds and mixes (regenerable from audio/reel/ and the reel JSONs)
audio/reel/**/*.wav
# Rendered FLAC stems anywhere under out/ and audio/ (regenerable from the mix scripts)
out/**/*.flac
audio/**/*.flac
# SFX library renders (regenerate with audio/sfx/scripts/build.py; the manifest stays tracked)
audio/sfx/wav/*.wav

# full-v3 art: the 4x copies are reproducible from native/ (the sheet tools)
out/ep01/full-v3/assets/*/full/
